# =============================================================================
# T&A Indien Rejsedagbog - Environment Variables
# =============================================================================
# Kopiér denne fil til .env.local og udfyld værdierne
# cp .env.example .env.local
# =============================================================================

# -----------------------------------------------------------------------------
# Media URL (påkrævet)
# -----------------------------------------------------------------------------
# Base URL for media files (Cloudflare R2 public bucket)
NEXT_PUBLIC_MEDIA_URL=https://pub-5e47b3255c9041c1834ddbed83e08fcb.r2.dev

# -----------------------------------------------------------------------------
# Mapbox Configuration (påkrævet for kortvisning)
# -----------------------------------------------------------------------------
# Opret en konto på https://www.mapbox.com/ og find din access token
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.your-public-token

# -----------------------------------------------------------------------------
# Journey Configuration (valgfri)
# -----------------------------------------------------------------------------
# Startdato for rejsen (Dag 0) i ISO-format
# Bruges til beregning af "Dag X" labels i feed
# Standard: 2025-12-18 hvis ikke angivet
NEXT_PUBLIC_JOURNEY_START_DATE=2025-12-18
